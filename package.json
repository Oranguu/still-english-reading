{
  "name": "still-english-reading",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, local English reading studio powered by your Codex subscription.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "launch": "node scripts/launch.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "test:e2e": "npm run build && node tests/browser.e2e.mjs",
    "format": "prettier --write src server scripts tests *.json *.ts *.html *.md"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "^16.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
